                        </button>
                        <button type="button" aria-label="Move '${p.text}' Down" onclick="moveParagraph(${idx}, 1)" class="p-1 hover:bg-slate-800 rounded text-slate-400 font-black focus:ring-2 focus:ring-spooky-necro focus:outline-none" ${idx === state.paragraphs.length - 1 ? 'style="opacity:0.2; pointer-events:none;" aria-disabled="true"' : ''}>
