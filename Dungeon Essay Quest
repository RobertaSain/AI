                    </div>
                    <div class="flex items-center space-x-1 shrink-0">
                        <button type="button" aria-label="Move '${p.text}' Up" onclick="moveParagraph(${idx}, -1)" class="p-1 hover:bg-slate-800 rounded text-slate-400 font-black focus:ring-2 focus:ring-spooky-necro focus:outline-none" ${idx === 0 ? 'style="opacity:0.2; pointer-events:none;" aria-disabled="true"' : ''}>
