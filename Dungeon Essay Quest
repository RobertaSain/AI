                        </button>
                    </div>
                `;
                container.appendChild(div);
            });
        }

        function moveParagraph(idx, direction) {
            const target = idx + direction;
            if (target < 0 || target >= state.paragraphs.length) return;

            // Swap positions
            const temp = state.paragraphs[idx];
            state.paragraphs[idx] = state.paragraphs[target];
            state.paragraphs[target] = temp;

            renderSortPuzzle();
            announceToScreenReader(`Swapped layout position ${idx + 1} with ${target + 1}.`);
        }

        function checkParagraphSort() {
            let correct = true;
            state.paragraphs.forEach((p, idx) => {
                if (p.correctOrder !== idx) correct = false;
