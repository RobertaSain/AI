<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TSI Essay Odyssey: Crypt of the Quill-Slayer</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        spooky: {
                            void: '#070a13',      /* Absolute Dark */
                            abyss: '#0e1326',     /* Dark Blue-Gray */
                            crypt: '#1b2342',     /* Medium Dungeon Blue */
                            necro: '#c084fc',     /* Glowing Poison Purple (Lightened for better contrast) */
                            ghost: '#4ade80',     /* Ghastly Green (Lightened for contrast) */
                            ectoplasm: '#22d3ee', /* Eerie Cyan (Lightened for contrast) */
                            ember: '#f97316',     /* Cursed Orange */
                            gold: '#fbbf24',      /* Ancient Gold */
                            blood: '#f87171',     /* Blood Red (Lightened for contrast) */
                            parchment: '#fef3c7'  /* Aged Scroll Yellow */
                        }
                    },
                    boxShadow: {
                        'retro-sm': '3px 3px 0px 0px #070a13',
                        'retro': '5px 5px 0px 0px #070a13',
                        'retro-lg': '9px 9px 0px 0px #070a13',
                        'retro-xl': '14px 14px 0px 0px #070a13'
                    },
                    fontFamily: {
                        sans: ['"Comic Sans MS"', 'system-ui', 'sans-serif'],
                        serif: ['Georgia', 'serif']
                    }
                }
            }
        }
    </script>
    <style>
        /* Floating animations */
        @keyframes float-slow {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-10px) rotate(2deg); }
        }
        .animate-float {
            animation: float-slow 4s infinite ease-in-out;
        }
        /* Heavy Comic/RPG Border style */
        .comic-border {
            border: 4px solid #070a13;
        }
        .comic-border-2 {
            border: 2px solid #070a13;
        }
    </style>
</head>
<body class="bg-spooky-void text-slate-100 min-h-screen flex flex-col font-sans selection:bg-spooky-necro selection:text-white antialiased">

    <!-- Screen Reader Visually Hidden Live Announcer (ADA Compliance) -->
    <div id="accessibleAnnouncer" class="sr-only" aria-live="polite">Quest initialized. Secure your college composition credits.</div>

    <!-- Spooky HUD / Game Header -->
    <header class="bg-spooky-abyss border-b-4 border-spooky-void sticky top-0 z-50 py-3 px-4 md:px-8 shadow-xl">
        <div class="max-w-7xl mx-auto flex flex-col lg:flex-row items-center justify-between gap-4">
            
            <!-- Logo / Ink-Knight Banner -->
            <button class="flex items-center space-x-3.5 text-left focus:ring-4 focus:ring-spooky-necro focus:outline-none rounded-xl p-1" onclick="goToTab('quest')" aria-label="Crypt of the Quill-Slayer game. Back to active game screen.">
                <div class="bg-spooky-necro comic-border p-2.5 rounded-xl shadow-retro-sm hover:rotate-2 transition-transform" aria-hidden="true">
                    <svg class="w-8 h-8 text-spooky-void" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222"></path>
                    </svg>
                </div>
                <div>
                    <h1 class="text-xl md:text-2xl font-black tracking-tight text-white uppercase flex items-center gap-2">
                        CRYPT OF THE QUILL-SLAYER <span aria-hidden="true">💀</span>
                    </h1>
                    <p class="text-xs text-spooky-necro font-bold uppercase tracking-wider">
                        TSI Essay Trials • Guided by <span class="text-spooky-gold font-black">Sir Sage Write</span>
                    </p>
                </div>
            </button>

            <!-- Mode Tabs (Quest / Archives) -->
            <nav class="flex items-center gap-2" aria-label="Game Navigation">
                <button id="btn-tab-quest" onclick="goToTab('quest')" class="bg-spooky-necro text-spooky-void font-black px-4 py-2 text-xs md:text-sm rounded-xl comic-border shadow-retro-sm hover:-translate-y-0.5 transition-transform focus:ring-4 focus:ring-white focus:outline-none">
                    ⚔️ Run the Crypt
                </button>
                <button id="btn-tab-archives" onclick="goToTab('archives')" class="bg-spooky-abyss text-slate-300 hover:bg-spooky-necro hover:text-spooky-void font-black px-4 py-2 text-xs md:text-sm rounded-xl comic-border shadow-retro-sm hover:-translate-y-0.5 transition-transform focus:ring-4 focus:ring-spooky-necro focus:outline-none">
                    📜 The Scholarly Tombs
                </button>
            </nav>

            <!-- Spooky RPG Player Status Panel -->
            <div id="hudStats" class="flex flex-wrap items-center gap-3 bg-spooky-void/90 p-3 rounded-2xl comic-border" aria-label="Hero Status Board">
                <!-- Resolve (Health) -->
                <div class="flex flex-col" aria-label="Rhetorical Resolve Health: 100 percent">
                    <div class="flex items-center justify-between text-[10px] font-black tracking-widest text-spooky-blood">
                        <span>RESOLVE (HP)</span>
                        <span id="hpValue">100 / 100</span>
                    </div>
                    <div class="w-24 md:w-32 bg-slate-900 h-2.5 rounded-full border border-slate-700 overflow-hidden relative mt-1">
                        <div id="hpBar" class="bg-gradient-to-r from-spooky-blood to-red-500 h-full rounded-full transition-all duration-300" style="width: 100%;"></div>
                    </div>
                </div>

                <div class="h-8 w-[2px] bg-slate-800 hidden md:block" aria-hidden="true"></div>

                <!-- Quest Progress Bar -->
                <div class="flex flex-col" aria-label="Crypt Progression">
                    <div class="flex items-center justify-between text-[10px] font-black tracking-widest text-spooky-ectoplasm uppercase">
                        <span>Progress</span>
                    </div>
                    <div class="w-24 md:w-32 bg-slate-900 h-2.5 rounded-full border border-slate-700 overflow-hidden relative mt-1">
                        <div id="progressBar" class="bg-gradient-to-r from-spooky-ectoplasm to-spooky-necro h-full rounded-full transition-all duration-300" style="width: 10%;"></div>
                    </div>
                </div>

                <div class="h-8 w-[2px] bg-slate-800 hidden md:block" aria-hidden="true"></div>

                <!-- Essay Score Rating -->
                <div class="flex flex-col" aria-label="TSI Score Potential">
                    <span class="text-[10px] font-black tracking-widest text-spooky-gold uppercase">TSI Level Potential</span>
                    <span id="scoreBadge" class="text-sm font-black text-spooky-ember">1 / 8 Points</span>
                </div>
            </div>

        </div>
    </header>

    <!-- Main Crypt Arena -->
    <main class="flex-1 max-w-6xl w-full mx-auto p-4 md:p-6 flex flex-col justify-center">
        
        <!-- ==================== TAB: PLAY QUEST ==================== -->
        <div id="tab-content-quest" class="space-y-6">
            
            <!-- Spooky Game Modals -->
            <div id="gameModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-spooky-void/80 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="modalTitle" aria-describedby="modalDesc">
                <div class="bg-spooky-abyss comic-border rounded-2xl p-6 max-w-md w-full shadow-retro-xl animate-float text-center space-y-4">
                    <div id="modalIcon" class="text-5xl" aria-hidden="true">👻</div>
                    <h2 id="modalTitle" class="text-lg font-black uppercase text-white tracking-widest">Spectral Feedback</h2>
                    <p id="modalDesc" class="text-sm text-slate-300 font-bold leading-relaxed"></p>
                    <button id="modalCloseBtn" onclick="closeModal()" class="w-full bg-spooky-necro hover:bg-purple-700 text-spooky-void font-black py-2.5 rounded-xl comic-border shadow-retro-sm transition focus:ring-4 focus:ring-white focus:outline-none">
                        CONTINUE EXPLORING 🗡️
                    </button>
                </div>
            </div>

            <!-- Stage 0: Entry Hall (Welcome Screen) -->
            <section id="screen-welcome" class="bg-spooky-abyss rounded-3xl comic-border p-6 md:p-10 shadow-retro-lg space-y-8 relative overflow-hidden" aria-labelledby="heading-welcome">
                
                <!-- Atmospheric background mists -->
                <div class="absolute -top-10 -right-10 bg-spooky-necro rounded-full w-44 h-44 opacity-10 blur-3xl" aria-hidden="true"></div>
                <div class="absolute -bottom-10 -left-10 bg-spooky-ghost rounded-full w-44 h-44 opacity-10 blur-3xl" aria-hidden="true"></div>

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
                    
                    <!-- Sir Sage Write SVG (Grizzled Veteran Knight Scholar) -->
                    <div class="lg:col-span-4 flex flex-col items-center">
                        <div class="bg-spooky-crypt p-4 rounded-3xl comic-border shadow-retro relative animate-float max-w-[240px]">
                            <!-- Grizzled Veteran Knight Scholar SVG -->
                            <svg class="w-full h-auto text-white" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Vector illustration of Sir Sage Write, clad in steel plate armor with a purple wizard hood and academic spectacles.">
                                <title>Sir Sage Write, the Ink-Knight Companion</title>
                                <!-- Background glowing aura -->
                                <circle cx="50" cy="50" r="42" fill="#a855f7" fill-opacity="0.15"/>
                                <!-- Iron Plate Armor Chest -->
                                <path d="M25 80 L75 80 L70 55 L30 55 Z" fill="#475569" stroke="#070a13" stroke-width="4" stroke-linejoin="round"/>
                                <path d="M45 55 L50 80 L55 55" stroke="#070a13" stroke-width="3"/>
                                <!-- Battle-torn Cloak -->
                                <path d="M15 50 C20 80 10 95 10 95 L25 80" stroke="#7c3aed" stroke-width="5" fill="none"/>
                                <path d="M85 50 C80 80 90 95 90 95 L75 80" stroke="#7c3aed" stroke-width="5" fill="none"/>
                                <!-- Iron Helmet Base -->
                                <rect x="32" y="28" width="36" height="32" rx="6" fill="#64748b" stroke="#070a13" stroke-width="4"/>
                                <!-- Knight Visor plate -->
                                <path d="M30 40 L70 40 L64 54 L36 54 Z" fill="#334155" stroke="#070a13" stroke-width="3"/>
                                <!-- Spectacles Welded to Helmet Plate -->
                                <circle cx="41" cy="46" r="8" stroke="#fbbf24" stroke-width="3" fill="none"/>
                                <circle cx="59" cy="46" r="8" stroke="#fbbf24" stroke-width="3" fill="none"/>
                                <line x1="49" y1="46" x2="51" y2="46" stroke="#fbbf24" stroke-width="3"/>
                                <!-- Glowing Visor Eyes (Under Glasses) -->
                                <circle cx="41" cy="46" r="2.5" fill="#22c55e" class="animate-pulse"/>
                                <circle cx="59" cy="46" r="2.5" fill="#22c55e" class="animate-pulse"/>
                                <!-- Battle scars across the helmet plate -->
                                <path d="M36 32 L40 38" stroke="#ef4444" stroke-width="2"/>
                                <path d="M62 30 L65 36" stroke="#ef4444" stroke-width="2"/>
                                <!-- Feathered Scholar's Ink-Quill helmet plume -->
                                <path d="M50 28 C50 10 65 5 70 8 C60 18 53 22 50 28" fill="#d8b4fe" stroke="#070a13" stroke-width="3"/>
                            </svg>
                            <!-- Word Bubble Badge -->
                            <div class="absolute -top-3 -right-6 bg-spooky-blood text-spooky-void text-[10px] font-black px-2.5 py-1 rounded-full comic-border rotate-12 uppercase tracking-wide" aria-hidden="true">
                                BATTLE-TESTED 💀
                            </div>
                        </div>
                        <p class="text-sm font-black text-white mt-4 text-center tracking-wider">SIR SAGE WRITE</p>
                        <p class="text-[10px] text-spooky-necro text-center uppercase tracking-widest font-extrabold">Veteran Knight of the College Composition</p>
                    </div>

                    <!-- Intro Story & Setup -->
                    <div class="lg:col-span-8 space-y-4">
                        <span class="bg-spooky-blood text-spooky-void text-xs font-black uppercase tracking-widest px-3 py-1.5 rounded-full comic-border shadow-retro-sm inline-block">
                            The Gates of Remedial Torment Await!
                        </span>
                        <h2 id="heading-welcome" tabindex="-1" class="text-3xl md:text-4xl font-black text-white uppercase leading-tight font-serif focus:outline-none">
                            TSIA2 Persuasive Writing Dungeon Crawl!
                        </h2>
                        <p class="text-sm md:text-base leading-relaxed text-slate-300 font-semibold">
                            Halt, young scribe! Before you are granted access to credit-bearing college classes, you must challenge the terrifying <strong class="text-spooky-gold">TSIA2 Essay Trial</strong>. Graders inspect your focus, support, and syntax. You must survive a persuasive essay of 300 to 600 words, securing at least <strong class="text-spooky-ghost">5 or 6 out of 8 points</strong>.
                        </p>
                        <p class="text-xs md:text-sm text-slate-400 leading-normal font-medium">
                            Fail, and you shall be trapped forever in the endless purgatory of non-credit remedial workshops! Clad yourself in my armor, sharpen your thesis blade, and prepare to banish the grammar wraiths lurking in the mist.
                        </p>

                        <!-- Equipment Inventory HUD -->
                        <div class="bg-spooky-void p-4 rounded-xl border-2 border-spooky-crypt space-y-2" aria-label="Knightly Inventory Checklist">
                            <h3 class="text-xs font-black text-slate-400 uppercase tracking-wider flex items-center gap-1.5">
                                🎒 YOUR ACTIVE KNIGHTLY INVENTORY:
                            </h3>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-3 text-xs font-bold text-slate-300">
                                <div class="bg-spooky-abyss p-2 rounded border border-slate-800 flex items-center gap-2">
                                    <span>⚔️ Blade:</span>
                                    <span id="inv-blade" class="text-spooky-blood font-bold">None (Locked)</span>
                                </div>
                                <div class="bg-spooky-abyss p-2 rounded border border-slate-800 flex items-center gap-2">
                                    <span>🛡️ Shield:</span>
                                    <span id="inv-shield" class="text-spooky-blood font-bold">None (Locked)</span>
                                </div>
                                <div class="bg-spooky-abyss p-2 rounded border border-slate-800 flex items-center gap-2">
                                    <span>🥾 Greaves:</span>
                                    <span id="inv-greaves" class="text-slate-300">Unstructured</span>
                                </div>
                            </div>
                        </div>

                        <div class="pt-2">
                            <button onclick="startQuest()" class="inline-flex items-center gap-2.5 bg-spooky-necro hover:bg-purple-700 text-spooky-void font-black text-sm px-7 py-4 rounded-2xl comic-border shadow-retro hover:-translate-y-0.5 transition-transform uppercase tracking-wider focus:ring-4 focus:ring-white focus:outline-none">
                                <span>ENTER THE WRITING CRYPT</span>
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M13 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                            </button>
                        </div>
                    </div>

                </div>
            </section>

            <!-- STAGE 1: Decoding the Prompt -->
            <section id="screen-stage1" class="hidden bg-spooky-abyss rounded-3xl comic-border p-6 md:p-8 shadow-retro-lg space-y-6" aria-labelledby="heading-stage1">
                
                <!-- Dynamic Back Button -->
                <button onclick="goBack()" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-spooky-void hover:bg-slate-900 border border-slate-700 rounded-lg text-xs font-bold text-slate-300 hover:text-white transition focus:ring-4 focus:ring-spooky-necro focus:outline-none shadow-retro-sm mb-1" aria-label="Retreat to the main gate entrance">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                    </svg>
                    <span>RETREAT</span>
                </button>

                <div class="flex items-center gap-3 border-b-4 border-slate-800 pb-4">
                    <span class="bg-spooky-necro text-spooky-void font-black w-10 h-10 rounded-full flex items-center justify-center text-sm comic-border shadow-retro-sm" aria-hidden="true">1</span>
                    <div>
                        <h2 id="heading-stage1" tabindex="-1" class="text-lg md:text-xl font-black uppercase text-white tracking-wider focus:outline-none">Stage 1: Decoding the Tombstone Inscription</h2>
                        <p class="text-xs text-slate-400 font-bold">Inspect the ancient text and choose your battle stance!</p>
                    </div>
                </div>

                <!-- Cursed Prompt Stone -->
                <div class="bg-slate-900 text-slate-300 p-6 rounded-2xl comic-border shadow-retro relative border-l-4 border-spooky-necro" aria-label="TSI Writing Prompt scroll">
                    <div class="absolute -top-3 -left-3 bg-spooky-blood text-spooky-void text-[10px] font-black px-2.5 py-1 rounded-lg comic-border rotate-[-4deg] tracking-widest uppercase" aria-hidden="true">
                        CURSED TOMBSTONE INSCRIPTION
                    </div>
                    <p class="text-sm md:text-base font-serif font-bold leading-relaxed mt-1">
                        "Some people argue that college degrees have become overpriced credentials that do not guarantee career stability, suggesting vocational training is better. Others insist that higher education is still the premier pathway for critical thinking and financial security. Write an essay explaining your position on whether a traditional college degree is still worth the investment."
                    </p>
                </div>

                <div class="space-y-4">
                    <p class="text-xs md:text-sm font-bold text-slate-300">
                        🛡️ <span class="text-spooky-gold font-black">Sir Sage's Advice:</span> Scribes who ride the fence and fail to choose a side will be drained of their power instantly. Choose a decisive direction to focus your blade:
                    </p>

                    <div class="grid grid-cols-1 gap-3.5" role="group" aria-label="Decide your thesis stance">
                        
                        <!-- Option A: Weak/Fence riding -->
                        <button onclick="selectStage1(1)" class="w-full text-left p-4 rounded-xl border-2 border-slate-800 bg-spooky-void/50 hover:bg-red-950/20 hover:border-spooky-blood group transition-all flex items-start gap-3 focus:ring-4 focus:ring-spooky-necro focus:outline-none">
                            <span class="w-6 h-6 rounded-full bg-slate-900 group-hover:bg-red-950 text-slate-400 font-black text-xs flex items-center justify-center shrink-0 border border-slate-700" aria-hidden="true">A</span>
                            <div class="flex-1">
                                <p class="text-xs font-black text-slate-500 group-hover:text-spooky-blood uppercase">The Passive Compromise (Fence-riding)</p>
                                <p class="text-sm font-bold text-slate-300 mt-0.5">"I will write that college works for some folks but trade school is awesome for others, and both arguments are totally right."</p>
                                <div id="fenceWarning" class="hidden text-xs text-spooky-blood font-black mt-2 bg-red-950/40 p-2.5 rounded-lg border border-spooky-blood">
                                    💀 PSYCHIC INFLICT! Choosing this route drains your health resolve. Prompt evaluators capped focus of neutral essays to a meager 3 points maximum.
                                </div>
                            </div>
                        </button>

                        <!-- Option B: Strong Affirmative -->
                        <button onclick="selectStage1(2)" class="w-full text-left p-4 rounded-xl border-2 border-slate-800 bg-spooky-void/50 hover:bg-emerald-950/20 hover:border-spooky-ghost group transition-all flex items-start gap-3 focus:ring-4 focus:ring-spooky-necro focus:outline-none">
                            <span class="w-6 h-6 rounded-full bg-slate-900 group-hover:bg-emerald-950 text-slate-400 font-black text-xs flex items-center justify-center shrink-0 border border-slate-700" aria-hidden="true">B</span>
                            <div>
                                <p class="text-xs font-black text-slate-500 group-hover:text-spooky-ghost uppercase">The College Sentinel (Affirmative)</p>
                                <p class="text-sm font-bold text-slate-300 mt-0.5">"I will state clearly that traditional university pathways remain worth the financial cost, using points on long-term earnings and systematic cognitive development."</p>
                            </div>
                        </button>

                        <!-- Option C: Strong Negative -->
                        <button onclick="selectStage1(3)" class="w-full text-left p-4 rounded-xl border-2 border-slate-800 bg-spooky-void/50 hover:bg-emerald-950/20 hover:border-spooky-ghost group transition-all flex items-start gap-3 focus:ring-4 focus:ring-spooky-necro focus:outline-none">
                            <span class="w-6 h-6 rounded-full bg-slate-900 group-hover:bg-emerald-950 text-slate-400 font-black text-xs flex items-center justify-center shrink-0 border border-slate-700" aria-hidden="true">C</span>
                            <div>
                                <p class="text-xs font-black text-slate-500 group-hover:text-spooky-ghost uppercase">The Guild Craftsman (Negative)</p>
                                <p class="text-sm font-bold text-slate-300 mt-0.5">"I will argue aggressively that college degrees are outdated credentials, citing devastating student loan debt and the high profit margins of trades."</p>
                            </div>
                        </button>

                    </div>
                </div>
            </section>

            <!-- STAGE 2: Forging the Thesis Weapon -->
            <section id="screen-stage2" class="hidden bg-spooky-abyss rounded-3xl comic-border p-6 md:p-8 shadow-retro-lg space-y-6" aria-labelledby="heading-stage2">
                
                <!-- Dynamic Back Button -->
                <button onclick="goBack()" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-spooky-void hover:bg-slate-900 border border-slate-700 rounded-lg text-xs font-bold text-slate-300 hover:text-white transition focus:ring-4 focus:ring-spooky-necro focus:outline-none shadow-retro-sm mb-1" aria-label="Retreat to the stance choosing chamber">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                    </svg>
                    <span>RETREAT</span>
                </button>

                <div class="flex items-center gap-3 border-b-4 border-slate-800 pb-4">
                    <span class="bg-spooky-necro text-spooky-void font-black w-10 h-10 rounded-full flex items-center justify-center text-sm comic-border shadow-retro-sm" aria-hidden="true">2</span>
                    <div>
                        <h2 id="heading-stage2" tabindex="-1" class="text-lg md:text-xl font-black uppercase text-white tracking-wider focus:outline-none">Stage 2: The Runecrafting Anvil</h2>
                        <p class="text-xs text-slate-400 font-bold">Forge your thesis blade. Select the path that aligns your focus!</p>
                    </div>
                </div>

                <div class="bg-slate-900 p-4 rounded-xl border-2 border-spooky-crypt flex items-center gap-3">
                    <span class="text-2xl" aria-hidden="true">⚡</span>
                    <p class="text-xs font-black text-slate-300">
                        Active Stance: <span id="stanceText" class="text-spooky-necro uppercase font-extrabold">...</span>. Select the runic formula to craft your blade:
                    </p>
                </div>

                <div class="space-y-4">
                    <div id="thesisOptions" class="grid grid-cols-1 gap-3.5" role="group" aria-label="Select a Runic Thesis Path">
                        <!-- Loaded dynamically -->
                    </div>
                </div>
            </section>

            <!-- STAGE 3: Gathering Shields of Evidence -->
            <section id="screen-stage3" class="hidden bg-spooky-abyss rounded-3xl comic-border p-6 md:p-8 shadow-retro-lg space-y-6" aria-labelledby="heading-stage3">
                
                <!-- Dynamic Back Button -->
