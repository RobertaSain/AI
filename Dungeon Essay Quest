        // Recalculates user score strictly based on current choices (Prevents backtracking point math bugs)
        function calculateScore() {
            let score = 1;
            if (state.stance !== '') {
                score = 3;
            }
            if (state.thesisId) {
                if (state.thesisId.includes('strong')) score += 2;
                else if (state.thesisId.includes('center')) score += 1;
            }
            if (state.evidenceId && state.evidenceId.includes('strong')) {
                score += 2;
            }
            if (state.currentStage >= 5) {
                score += 1; // Awarded for correctly sorting Paragraph outline
            }
            if (state.grammar1Answered && state.grammar1Correct) {
                score += 1;
            }
            if (state.grammar2Answered && state.grammar2Correct) {
                score += 1;
            }
            return Math.min(8, Math.max(1, score));
        }

